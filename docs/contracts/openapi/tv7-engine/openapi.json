{
  "openapi": "3.1.0",
  "info": {
    "title": "TV7 Engine Local API",
    "version": "0.3.0",
    "description": "Local-only engine sidecar API exposed on loopback. Studio starts this service and uses it as the mandatory boundary for local media compute."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7070",
      "description": "Default local sidecar address"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/diagnostics": {
      "get": {
        "summary": "Inspect local engine readiness",
        "operationId": "getDiagnostics",
        "description": "Reports Engine-managed media readiness for Studio. ffmpeg and ffprobe are required for probe, thumbnail, and render_clip. yt-dlp is required for url_ingest and transcript.",
        "responses": {
          "200": {
            "description": "Diagnostics payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineDiagnostics"
                }
              }
            }
          }
        }
      }
    },
    "/v1/setup/manifest": {
      "get": {
        "summary": "Inspect Engine-known runtime setup options",
        "operationId": "getSetupManifest",
        "description": "Returns setup modes, AI provider resolution order, and installable/importable local runtime assets. Engine prefers user-installed local AI first, TV7-managed local AI second, and TV7 cloud AI third.",
        "responses": {
          "200": {
            "description": "Setup manifest payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupManifest"
                }
              }
            }
          }
        }
      }
    },
    "/v1/setup/status": {
      "get": {
        "summary": "Inspect current local runtime setup status",
        "operationId": "getSetupStatus",
        "description": "Reports detected user-installed runtimes and models, TV7-managed installable fallbacks, and capability readiness. Missing assets require explicit Studio/user action before Engine downloads or installs anything.",
        "responses": {
          "200": {
            "description": "Setup status payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/media/probe": {
      "post": {
        "summary": "Probe local media metadata",
        "operationId": "probeMedia",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProbeRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "path": "/absolute/path/to/video.mp4"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Probe metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/CommandFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalFailure"
          },
          "502": {
            "$ref": "#/components/responses/OutputInvalid"
          }
        }
      }
    },
    "/v1/media/thumbnail": {
      "post": {
        "summary": "Generate a thumbnail image for local media",
        "operationId": "generateThumbnail",
        "description": "Always overwrites the output file. Studio owns workspace paths, must pass absolute source and output paths, and must create the output parent directory before calling Engine.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThumbnailRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "source_path": "/absolute/path/to/video.mp4",
                    "output_path": "/absolute/path/to/video.mp4.thumb.jpg",
                    "timestamp_seconds": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thumbnail generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThumbnailResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/CommandFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalFailure"
          }
        }
      }
    },
    "/v1/media/render-clip": {
      "post": {
        "summary": "Render a frame-accurate local clip",
        "operationId": "renderClip",
        "description": "Always overwrites the output file. Studio owns workspace paths, must pass absolute source and output paths, and must create the output parent directory before calling Engine.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderClipRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "source_path": "/absolute/path/to/video.mp4",
                    "output_path": "/absolute/path/to/video_clip.mp4",
                    "start_seconds": 12.5,
                    "end_seconds": 42.5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Clip rendered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderClipResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/CommandFailed"
          },
          "500": {
            "$ref": "#/components/responses/InternalFailure"
          }
        }
      }
    },
    "/v1/ingest/url": {
      "post": {
        "summary": "Start a job-backed URL ingest",
        "operationId": "startUrlIngest",
        "description": "Starts a local yt-dlp ingest job. URL must be public http/https; localhost and private-network hosts are rejected. The initial response is 202 with a job payload; Studio polls /v1/jobs/{id} for completion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UrlIngestRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "url": "https://example.com/video",
                    "output_dir": "/absolute/path/to/workspace",
                    "output_template": "%(title).200B.%(ext)s"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Ingest job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/v1/transcripts/download": {
      "post": {
        "summary": "Start a job-backed transcript download",
        "operationId": "startTranscriptDownload",
        "description": "Starts a local yt-dlp transcript download job. URL must be public http/https; localhost and private-network hosts are rejected. Studio polls /v1/jobs/{id} for completion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptDownloadRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "url": "https://example.com/video",
                    "output_path": "/absolute/path/to/video.vtt",
                    "language": "en"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Transcript job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/v1/transcripts/generate": {
      "post": {
        "summary": "Start a job-backed local transcript generation",
        "operationId": "startTranscriptGenerate",
        "description": "Starts local Whisper transcript generation for an imported local media file. Engine queues a job only when local transcription setup is ready. Engine never auto-downloads transcription runtimes or models from this endpoint; missing setup returns TRANSCRIPTION_SETUP_REQUIRED.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptGenerateRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "media_path": "/absolute/path/to/video.mp4",
                    "output_path": "/absolute/path/to/video.vtt",
                    "language": "en"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Transcript generation job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/TranscriptionSetupRequired"
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "summary": "Fetch local Engine job state",
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineJob"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/jobs/{id}/logs": {
      "get": {
        "summary": "Fetch local Engine job logs",
        "operationId": "getJobLogs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job logs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobLogsResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/jobs/{id}/cancel": {
      "post": {
        "summary": "Request local Engine job cancellation",
        "operationId": "cancelJob",
        "description": "Marks a queued or running job as cancelled. Current EN-A04 cancellation is cooperative at the Engine job state boundary; process-level termination for an already-running yt-dlp child process is a follow-up hardening item.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineJob"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/ai/cloud-token": {
      "post": {
        "summary": "Store delegated TV7 cloud AI token in memory",
        "operationId": "setCloudAiToken",
        "description": "Studio passes a short-lived Backend-issued engine:cloud_ai bearer token to Engine over loopback. Engine stores it in memory only and never returns the token value.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloudAiTokenRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "token": "backend-issued-delegated-token",
                    "token_type": "bearer",
                    "scope": "engine:cloud_ai",
                    "expires_in_seconds": 900,
                    "credits_remaining": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delegated token metadata stored in memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudAiTokenStatusResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },
      "delete": {
        "summary": "Clear delegated TV7 cloud AI token",
        "operationId": "clearCloudAiToken",
        "description": "Clears the in-memory delegated cloud AI token during logout, license refresh, or revocation.",
        "responses": {
          "200": {
            "description": "Delegated token cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudAiTokenStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai/cloud-debug": {
      "post": {
        "summary": "Check TV7 cloud AI readiness through Engine",
        "operationId": "debugCloudAi",
        "description": "Engine validates local delegated-token state and, when present, calls Backend cloud AI execution with an Engine-shaped minimal health prompt. Studio should use this instead of calling Backend AI debug endpoints directly.",
        "responses": {
          "200": {
            "description": "Cloud AI readiness payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloudAiDebugResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai/transcript-intelligence": {
      "post": {
        "summary": "Generate transcript intelligence clip suggestions",
        "operationId": "generateTranscriptIntelligence",
        "description": "Studio-facing AI endpoint for Quick Clip-style transcript analysis. Engine owns prompt/context shaping and provider dispatch. The first executable provider path is TV7 cloud AI via Backend using an in-memory delegated token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptIntelligenceRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "transcript": [
                      {
                        "start_seconds": 1,
                        "end_seconds": 5,
                        "text": "This is a useful hook."
                      }
                    ],
                    "clip_duration": "medium",
                    "timeline_target": "entire_video",
                    "existing_clips": [],
                    "max_suggestions": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcript intelligence result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptIntelligenceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/BadRequest"
          },
          "402": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/BadRequest"
          },
          "413": {
            "$ref": "#/components/responses/BadRequest"
          },
          "502": {
            "$ref": "#/components/responses/OutputInvalid"
          },
          "503": {
            "$ref": "#/components/responses/InternalFailure"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "File not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "CommandFailed": {
        "description": "Local media command failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TranscriptionSetupRequired": {
        "description": "Local transcription runtime/model setup is required before transcript generation can start",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SetupRequiredResponse"
            }
          }
        }
      },
      "OutputInvalid": {
        "description": "Unexpected command output",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalFailure": {
        "description": "Internal failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "EngineDiagnostics": {
        "type": "object",
        "required": [
          "status",
          "runtime",
          "capabilities",
          "tools",
          "work_dir"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/DiagnosticStatus"
          },
          "runtime": {
            "$ref": "#/components/schemas/RuntimeDiagnostic"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityDiagnostic"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolDiagnostic"
            }
          },
          "work_dir": {
            "$ref": "#/components/schemas/WorkDirDiagnostic"
          }
        }
      },
      "RuntimeDiagnostic": {
        "type": "object",
        "required": [
          "engine_version",
          "host",
          "port"
        ],
        "properties": {
          "engine_version": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        }
      },
      "DiagnosticStatus": {
        "type": "string",
        "enum": [
          "ready",
          "degraded"
        ]
      },
      "CapabilityDiagnostic": {
        "type": "object",
        "required": [
          "name",
          "status",
          "required_tools"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DiagnosticStatus"
          },
          "required_tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ToolDiagnostic": {
        "type": "object",
        "required": [
          "name",
          "available",
          "version",
          "required_for",
          "error"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean",
            "nullable": true,
            "description": "null means the tool is known but not checked for this milestone."
          },
          "version": {
            "type": "string",
            "nullable": true
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "WorkDirDiagnostic": {
        "type": "object",
        "required": [
          "path",
          "ready",
          "error"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProviderSource": {
        "type": "string",
        "enum": [
          "user_path",
          "tv7_managed",
          "bundled",
          "ollama",
          "tv7_cloud",
          "unconfigured"
        ]
      },
      "RuntimeAssetKind": {
        "type": "string",
        "enum": [
          "media_tool",
          "transcription_runtime",
          "transcription_model",
          "llm_runtime",
          "llm_model"
        ]
      },
      "SetupItemStatus": {
        "type": "string",
        "enum": [
          "available",
          "missing",
          "installable",
          "unsupported"
        ]
      },
      "ProviderCandidateStatus": {
        "type": "string",
        "enum": [
          "ready",
          "missing_assets",
          "installable",
          "unavailable"
        ]
      },
      "SetupCapabilityState": {
        "type": "string",
        "enum": [
          "ready",
          "not_ready"
        ]
      },
      "SetupManifest": {
        "type": "object",
        "required": [
          "schema_version",
          "platform",
          "setup_modes",
          "ai_provider_order",
          "assets"
        ],
        "properties": {
          "schema_version": {
            "type": "integer"
          },
          "platform": {
            "type": "string"
          },
          "setup_modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ai_provider_order": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderSource"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetupManifestAsset"
            }
          }
        }
      },
      "SetupManifestAsset": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "required_for",
          "installable",
          "bundled",
          "source",
          "version",
          "download"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/RuntimeAssetKind"
          },
          "name": {
            "type": "string"
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installable": {
            "type": "boolean"
          },
          "bundled": {
            "type": "boolean"
          },
          "source": {
            "$ref": "#/components/schemas/ProviderSource"
          },
          "version": {
            "type": "string",
            "nullable": true
          },
          "download": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SetupDownload"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SetupDownload": {
        "type": "object",
        "required": [
          "url",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "schema_version",
          "setup_complete",
          "active_ai_provider",
          "assets",
          "ai_providers",
          "capabilities"
        ],
        "properties": {
          "schema_version": {
            "type": "integer"
          },
          "setup_complete": {
            "type": "boolean"
          },
          "active_ai_provider": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProviderSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetupAssetStatus"
            }
          },
          "ai_providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiProviderCandidate"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetupCapabilityStatus"
            }
          }
        }
      },
      "SetupAssetStatus": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "status",
          "source",
          "path",
          "version",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/RuntimeAssetKind"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SetupItemStatus"
          },
          "source": {
            "$ref": "#/components/schemas/ProviderSource"
          },
          "path": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AiProviderCandidate": {
        "type": "object",
        "required": [
          "source",
          "status",
          "required_assets",
          "requires_internet",
          "requires_user_confirmation",
          "cost_policy",
          "action"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/ProviderSource"
          },
          "status": {
            "$ref": "#/components/schemas/ProviderCandidateStatus"
          },
          "required_assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_internet": {
            "type": "boolean"
          },
          "requires_user_confirmation": {
            "type": "boolean"
          },
          "cost_policy": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SetupCapabilityStatus": {
        "type": "object",
        "required": [
          "name",
          "status",
          "provider",
          "missing",
          "installable",
          "user_action_required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SetupCapabilityState"
          },
          "provider": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProviderSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installable": {
            "type": "boolean"
          },
          "user_action_required": {
            "type": "boolean"
          }
        }
      },
      "ProbeRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute local filesystem path to media file."
          }
        }
      },
      "ProbeResponse": {
        "type": "object",
        "required": [
          "metadata"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/MediaMetadata"
          }
        }
      },
      "MediaMetadata": {
        "type": "object",
        "required": [
          "path",
          "duration_seconds",
          "width",
          "height",
          "format",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true
          },
          "width": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "height": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "format": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ThumbnailRequest": {
        "type": "object",
        "required": [
          "source_path",
          "output_path"
        ],
        "properties": {
          "source_path": {
            "type": "string"
          },
          "output_path": {
            "type": "string"
          },
          "timestamp_seconds": {
            "type": "number",
            "nullable": true,
            "default": 1,
            "minimum": 0
          }
        }
      },
      "ThumbnailResponse": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "$ref": "#/components/schemas/ThumbnailResult"
          }
        }
      },
      "ThumbnailResult": {
        "type": "object",
        "required": [
          "output_path"
        ],
        "properties": {
          "output_path": {
            "type": "string"
          }
        }
      },
      "RenderClipRequest": {
        "type": "object",
        "required": [
          "source_path",
          "output_path",
          "start_seconds",
          "end_seconds"
        ],
        "properties": {
          "source_path": {
            "type": "string"
          },
          "output_path": {
            "type": "string"
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0,
            "description": "Start time of the clip in seconds. Must be >= 0 and less than end_seconds."
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "End time of the clip in seconds. Must be > start_seconds."
          }
        }
      },
      "RenderClipResponse": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "$ref": "#/components/schemas/RenderClipResult"
          }
        }
      },
      "RenderClipResult": {
        "type": "object",
        "required": [
          "output_path",
          "duration_seconds"
        ],
        "properties": {
          "output_path": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "UrlIngestRequest": {
        "type": "object",
        "required": [
          "url",
          "output_dir"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "output_dir": {
            "type": "string",
            "description": "Existing absolute local directory where Engine writes downloaded media. Studio must create it before calling Engine."
          },
          "output_template": {
            "type": "string",
            "description": "Optional yt-dlp output template relative to output_dir."
          }
        }
      },
      "UrlIngestResult": {
        "type": "object",
        "required": [
          "url",
          "metadata"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "media_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "TranscriptDownloadRequest": {
        "type": "object",
        "required": [
          "url",
          "output_path"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "output_path": {
            "type": "string",
            "description": "Absolute local VTT output path requested by Studio. The parent directory must exist before calling Engine."
          },
          "language": {
            "type": "string",
            "default": "en"
          }
        }
      },
      "TranscriptDownloadResult": {
        "type": "object",
        "required": [
          "language"
        ],
        "properties": {
          "transcript_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": "string"
          }
        }
      },
      "TranscriptGenerateRequest": {
        "type": "object",
        "required": [
          "media_path",
          "output_path"
        ],
        "properties": {
          "media_path": {
            "type": "string",
            "description": "Absolute local media path to transcribe."
          },
          "output_path": {
            "type": "string",
            "description": "Absolute local .vtt output path requested by Studio. The parent directory must exist before calling Engine."
          },
          "language": {
            "type": "string",
            "default": "en"
          }
        }
      },
      "TranscriptGenerateResult": {
        "type": "object",
        "required": [
          "transcript_path",
          "format",
          "language"
        ],
        "properties": {
          "transcript_path": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "vtt"
            ]
          },
          "language": {
            "type": "string"
          }
        }
      },
      "JobCreateResponse": {
        "type": "object",
        "required": [
          "job"
        ],
        "properties": {
          "job": {
            "$ref": "#/components/schemas/EngineJob"
          }
        }
      },
      "JobLogsResponse": {
        "type": "object",
        "required": [
          "job_id",
          "logs"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EngineJob": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "progress",
          "logs",
          "cancel_requested"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "url_ingest",
              "transcript_download",
              "transcript_generate"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UrlIngestResult"
              },
              {
                "$ref": "#/components/schemas/TranscriptDownloadResult"
              },
              {
                "$ref": "#/components/schemas/TranscriptGenerateResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "cancel_requested": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SetupRequiredResponse": {
        "type": "object",
        "required": [
          "error",
          "message",
          "missing",
          "setup_capability"
        ],
        "properties": {
          "error": {
            "type": "string",
            "const": "TRANSCRIPTION_SETUP_REQUIRED"
          },
          "message": {
            "type": "string"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "transcription_runtime",
                "transcription_model"
              ]
            }
          },
          "setup_capability": {
            "type": "string",
            "const": "transcription"
          }
        }
      },
      "CloudAiTokenRequest": {
        "type": "object",
        "required": [
          "token",
          "expires_in_seconds"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Backend-issued delegated token. Never returned by Engine responses."
          },
          "token_type": {
            "type": "string",
            "default": "bearer"
          },
          "scope": {
            "type": "string",
            "default": "engine:cloud_ai"
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "credits_remaining": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CloudAiTokenStatusResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CloudAiTokenStatus"
          }
        }
      },
      "CloudAiTokenStatus": {
        "type": "object",
        "required": [
          "state",
          "scope",
          "token_type",
          "expires_in_seconds",
          "credits_remaining"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/CloudAiTokenState"
          },
          "scope": {
            "type": "string",
            "nullable": true
          },
          "token_type": {
            "type": "string",
            "nullable": true
          },
          "expires_in_seconds": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "credits_remaining": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CloudAiTokenState": {
        "type": "string",
        "enum": [
          "configured",
          "missing",
          "expired"
        ]
      },
      "CloudAiDebugResponse": {
        "type": "object",
        "required": [
          "provider",
          "status",
          "error",
          "token"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "const": "tv7_cloud"
          },
          "status": {
            "$ref": "#/components/schemas/CloudAiDebugState"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "enum": [
              "AI_AUTH_REQUIRED",
              "AI_LICENSE_REQUIRED",
              "AI_QUOTA_EXCEEDED",
              "AI_PROVIDER_UNAVAILABLE",
              "AI_NETWORK_UNAVAILABLE",
              "AI_CONTEXT_TOO_LARGE",
              null
            ]
          },
          "token": {
            "$ref": "#/components/schemas/CloudAiTokenStatus"
          }
        }
      },
      "CloudAiDebugState": {
        "type": "string",
        "enum": [
          "ready",
          "not_ready"
        ]
      },
      "TranscriptIntelligenceRequest": {
        "type": "object",
        "required": [
          "transcript",
          "clip_duration",
          "timeline_target"
        ],
        "properties": {
          "transcript": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/TranscriptCue"
            }
          },
          "clip_duration": {
            "$ref": "#/components/schemas/ClipDurationPreset"
          },
          "timeline_target": {
            "$ref": "#/components/schemas/TimelineTarget"
          },
          "existing_clips": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/ExistingClip"
            }
          },
          "max_suggestions": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 12
          }
        }
      },
      "TranscriptCue": {
        "type": "object",
        "required": [
          "start_seconds",
          "end_seconds",
          "text"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ExistingClip": {
        "type": "object",
        "required": [
          "start_seconds",
          "end_seconds"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "ClipDurationPreset": {
        "type": "string",
        "enum": [
          "short",
          "medium",
          "long"
        ]
      },
      "TimelineTarget": {
        "type": "string",
        "enum": [
          "unclipped_gaps_only",
          "entire_video"
        ]
      },
      "ProviderExecutionSource": {
        "type": "string",
        "enum": [
          "ollama",
          "tv7_managed",
          "tv7_cloud"
        ]
      },
      "TranscriptIntelligenceResponse": {
        "type": "object",
        "required": [
          "provider",
          "model",
          "clips",
          "usage"
        ],
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/ProviderExecutionSource"
          },
          "model": {
            "type": "string"
          },
          "clips": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiClipSuggestion"
            }
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CloudAiUsage"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AiClipSuggestion": {
        "type": "object",
        "required": [
          "title",
          "start_seconds",
          "end_seconds",
          "reason",
          "score"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "CloudAiUsage": {
        "type": "object",
        "required": [
          "credits_charged",
          "credits_remaining"
        ],
        "properties": {
          "credits_charged": {
            "type": "integer"
          },
          "credits_remaining": {
            "type": "integer"
          },
          "prompt_tokens": {
            "type": "integer",
            "nullable": true
          },
          "completion_tokens": {
            "type": "integer",
            "nullable": true
          },
          "total_tokens": {
            "type": "integer",
            "nullable": true
          },
          "latency_ms": {
            "type": "integer",
            "nullable": true
          }
        }
      }
    }
  }
}
